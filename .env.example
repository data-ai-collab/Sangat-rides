# --- Neon Postgres ---
# Pooled connection string (Neon dashboard > Connection details > "Pooled connection")
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-2.aws.neon.tech/sangatrides?sslmode=require&pgbouncer=true"
# Direct (non-pooled) connection string, used by `prisma db push`
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-2.aws.neon.tech/sangatrides?sslmode=require"

# --- Sign-in ---
# Long random string used to sign login cookies. Generate one with:  openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"
# Password for the coordinator / phone-desk volunteers
ADMIN_PASSWORD="choose-a-strong-password"

# --- Public site ---
# The public address of the site, e.g. https://sangatrides.netlify.app (used for the phone line)
PUBLIC_BASE_URL="https://sangatrides.netlify.app"

# --- Brevo (https://app.brevo.com) email + SMS ---
# SMTP & API > API keys > Generate a new API key
BREVO_API_KEY=""
# A sender address you have verified in Brevo (Senders, Domains & Dedicated IPs > Senders)
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="Sangat Rides"
# Text messages to riders cost Brevo SMS credits. Leave "false" until you have bought credits.
BREVO_SMS_ENABLED="false"
# Name shown as the SMS sender: letters and digits only, max 11 characters
BREVO_SMS_SENDER="SangatRides"

# Secret used by the Saturday-evening reminder job. Generate with:  openssl rand -base64 24
CRON_SECRET=""

# --- Optional: automated phone line (Twilio) ---
# Leave blank to skip. When set, incoming call requests are checked against this token.
TWILIO_AUTH_TOKEN=""
